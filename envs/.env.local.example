## 앱 로컬 환경변수 템플릿
## 사용: cp envs/.env.local.example envs/.env.local

APP_ENV=local
PORT=8080

## 타임아웃은 기본값이 코드에 있다. 바꿀 때만 주석 해제
# SERVER_READ_TIMEOUT=5s

## DATABASE (docker-compose 로 띄운 로컬 Postgres 기준 — make db-up)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=go-gin-boiler
DB_USERNAME=root
DB_PASSWORD=password

## 아래는 기본값이 코드에 있다. 바꿀 때만 주석 해제
# DB_SCHEMA=public
# DB_SSL_MODE=disable
# DB_MAX_OPEN_CONNS=10
# DB_MAX_IDLE_CONNS=5
# DB_CONN_MAX_LIFETIME=30m
